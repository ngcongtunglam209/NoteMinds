# Production config for docker compose: copy to .env in the repo root and fill in.
# (Local dev without Docker uses server/.env and client/.env instead; see their .env.example.)
# docker-compose.yml already sets NODE_ENV=production, TRUST_PROXY=1, DATABASE_PATH=/app/data/notemind.db, PORT=3001.

# ── AI (DashScope / Qwen, OpenAI-compatible API) ──
# Legacy names QWEN_API_KEY / QWEN_API_BASE_URL are still accepted as fallbacks.
DASHSCOPE_API_KEY=
# Optional; default https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Optional; default qwen3-max
QWEN_MODEL=

# ── Cloudflare Turnstile ──
# Secret (server). Unset = captcha disabled; the server warns at startup in production.
TURNSTILE_SECRET_KEY=
# Site key (public, baked into the client bundle at image build time: rebuild nginx after changing).
VITE_TURNSTILE_SITE_KEY=
